{
  "manifest_version": 3,
  "name": "HireTrack AI - 1-Click Job Clipper",
  "version": "1.1.0",
  "description": "Clip job opportunities, salaries, and descriptions directly from Indeed, LinkedIn, Naukri, and any careers site into your HireTrack AI pipeline.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Clip Job to HireTrack"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.indeed.com/*",
        "*://*.linkedin.com/*",
        "*://*.naukri.com/*",
        "*://*.glassdoor.com/*",
        "*://*.wellfound.com/*"
      ],
      "js": ["content.js"]
    }
  ]
}
