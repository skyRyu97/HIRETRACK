  "cards": [
    {
      "dot": "cyan",
      "title": "Client & In-Memory Session",
      "items": [
        "React 18 SPA with Kanban board, Resume Vault, and Analytics velocity graphs",
        "Axios client holds JWT access tokens strictly in memory (no localStorage leaks)",
        "Automatic 401 response interceptor silently refreshes tokens via httpOnly cookie"
      ]
    },
    {
      "dot": "emerald",
      "title": "Application Core & Clean Cascade",
      "items": [
        "Multer memory storage processes PDFs in RAM with zero disk persistence",
        "Strict IDOR verification ensures users only read, update, or clip their own records",
        "Cascading deletion cleans up MatchResults when jobs or resumes are removed"
      ]
    },
    {
      "dot": "amber",
      "title": "AI Match Cascade & Automation",
      "items": [
        "Kanban controller checks SHA-256 hash cache and 10/day quota before AI invocation",
        "Gemini cascade tries 3.5-Flash, falls back to Flash-Lite, then offline heuristic",
        "Daily cron scans indexed followUpAt timestamps and emails digests via Resend"
      ]
    }
  ]
